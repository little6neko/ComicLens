COMICLENS_HOST=0.0.0.0
PORT=8233
COMICLENS_DATA_DIR=/app/data
COMICLENS_CACHE_MAX_MB=5120
COMICLENS_ACCESS_PASSWORD=
COMICLENS_UPSTREAM_BASE_URL=https://manga18fx.com
COMICLENS_REQUEST_TIMEOUT=30
COMICLENS_LOG_LEVEL=INFO

# Only used to seed missing server settings on first startup.
OCR_AUTH_MODE=token
OCR_API_URL=
OCR_TOKEN=
OCR_BASIC_USERNAME=
OCR_BASIC_PASSWORD=
OCR_JOB_MODEL=PaddleOCR-VL-1.5
OCR_JOB_POLL_INTERVAL=2
OCR_JOB_TIMEOUT=180
OCR_REQUEST_CONCURRENCY=1
DEEPLX_URL=
FALLBACK_PROXY_URL=
APP_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
